<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/strike_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="10dp">

    <!-- TopBar: logo + connection dot + settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Strike logo"
            android:src="@drawable/ic_bolt" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Strike"
            android:textColor="@color/strike_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/connDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_red" />

        <ImageButton
            android:id="@+id/settingsBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Greeting: time-aware + state subtitle -->
    <TextView
        android:id="@+id/greeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Good evening"
        android:textColor="@color/strike_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Ready — say Hey Strike"
        android:textColor="@color/strike_text2"
        android:textSize="15sp" />

    <!-- Quick actions: hidden once the conversation starts -->
    <HorizontalScrollView
        android:id="@+id/chipScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chipRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipChrome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:text="Open Chrome"
                android:textColor="@color/strike_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chipWhatsApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:text="Open WhatsApp"
                android:textColor="@color/strike_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chipYouTube"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:text="Open YouTube"
                android:textColor="@color/strike_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chipSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:text="Open Settings"
                android:textColor="@color/strike_text"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Conversation: chat bubbles (user right / Strike left) -->
    <ListView
        android:id="@+id/chatList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:overScrollMode="never"
        android:stackFromBottom="true"
        android:transcriptMode="alwaysScroll" />

    <!-- Phone-control / task card -->
    <LinearLayout
        android:id="@+id/taskCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/taskDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_green" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Strike is working"
                android:textColor="@color/strike_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/stopBtn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip"
                android:contentDescription="Stop the running task"
                android:minWidth="72dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Stop"
                android:textColor="@color/strike_err"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/taskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/strike_text2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/taskStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/strike_text"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Say “Hey Strike”"
        android:textColor="@color/strike_text2"
        android:textSize="12sp" />

    <!-- Pinned mic button -->
    <ImageButton
        android:id="@+id/micBtn"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_mic"
        android:contentDescription="Talk to Strike"
        android:padding="18dp"
        android:src="@drawable/ic_mic" />

    <!-- Text input + send -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/textBox"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="Ask Strike..."
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/strike_text"
            android:textColorHint="@color/strike_text2"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/sendBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_send"
            android:contentDescription="Send message"
            android:padding="12dp"
            android:src="@drawable/ic_send" />
    </LinearLayout>
</LinearLayout>
