<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="Hey Strike"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:text="Siri-style voice for PocketStrike (Termux server must run: start-all.sh)"
        android:layout_marginTop="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <EditText
        android:id="@+id/serverBox"
        android:hint="http://127.0.0.1:5000"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button android:id="@+id/grantBtn" android:text="1. Grant mic permission"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

    <Button android:id="@+id/overlayBtn" android:text="2. Allow display over apps (Siri orb)"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

    <Button android:id="@+id/saveBtn" android:text="3. Save server address"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

    <Button android:id="@+id/startBtn" android:text="4. Start always-on listening"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

    <Button android:id="@+id/talkBtn" android:text="🎙️ Talk now (show orb)"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

    <TextView android:id="@+id/statusText"
        android:layout_marginTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
